
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport">
  <title>Your Post</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
</head>
<body>

  <%- include("partials/header.ejs") %>

  <main>

    <div class="mb-3 main-title">
      Your Post
    </div>

<div class="user-edit">
  <div id="user-title">
    <%= title %>
  </div>
  <div id="user-context">
    <%= context %>
    <p id="currentday"></p>
    <script>
      const d = new Date();
      document.getElementById("currentday").innerHTML = d.toUTCString();
      </script>
  </div>
</div>

<form action="/context" method="post">
    <button type="context" class="btn btn-outline-primary">수정</button>  <button type="reset" class="btn btn-outline-primary">삭제</button>
  </form>

  </main>

  <%- include("partials/footer.ejs") %>

<script src="/js/main.js"></script>
</body>
</html>
